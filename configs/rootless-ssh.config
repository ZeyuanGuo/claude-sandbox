# Rootless SSH: every alias uses a dedicated reverse Unix socket.
# The socket endpoint, not the command line, fixes the destination.
Host mainstorage
    HostName 100.117.92.79
    Port 22
    User gzy
    IdentityFile /run/cdm-ssh/id_ed25519_fleet
    IdentitiesOnly yes
    HostKeyAlias gamma-mesh-mainstorage
    StrictHostKeyChecking yes
    UserKnownHostsFile /run/cdm-ssh/known_hosts
    ProxyCommand env PYTHONPATH=/opt/cdm-ssh python3 /opt/cdm-ssh/controlled_dev_machine/ssh_bridge.py client --raw --expected-host 100.117.92.79 --expected-port 22 --socket /run/cdm-ssh/mainstorage-100.sock %h %p

