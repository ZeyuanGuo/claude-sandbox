#!/bin/sh
set -eu
repo=$(CDM_DEGRADED_REPO=${CDM_DEGRADED_REPO:-"$HOME/5090-recovery/priority-home/claude-sandbox"} \
    /usr/bin/python3 -c 'import os; print(os.environ["CDM_DEGRADED_REPO"])')
export CDM_DEGRADED_REPO="$repo"
export PYTHONPATH="$repo/src${PYTHONPATH:+:$PYTHONPATH}"
exec /usr/bin/python3 -m controlled_dev_machine.degraded_rootless "$@"
