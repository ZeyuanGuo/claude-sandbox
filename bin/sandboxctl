#!/bin/sh
set -eu
RELEASE=/opt/controlled-dev-machine/release
if [ ! -d "$RELEASE/src/controlled_dev_machine" ]; then
    SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
    RELEASE=$(CDPATH= cd -- "$SCRIPT_DIR/.." && pwd)
fi
export PYTHONPATH="$RELEASE/src${PYTHONPATH:+:$PYTHONPATH}"
PYTHON=${CDM_PYTHON:-/opt/controlled-dev-machine/venv/bin/python}
exec "$PYTHON" -m controlled_dev_machine "$@"
